NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Edge Functions only — configure with `supabase secrets set`, never expose in Next.js.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Agendamentos <agendamentos@your-domain.example>
APP_URL=https://your-app.example
IP_HASH_SALT=generate-a-long-random-value
CRON_SECRET=generate-a-different-long-random-value
